# (Named *.toml.in: the packager refuses .toml files outside src/.)
# Corn Delight's blocks and items as tools/gen_cd_decls.py reads them (CD-04). Paths: CDj = Corn Delight
# src/main/java/cn/mcmod/corn_delight, CDg = src/generated/resources (ab03743e), FD = the FD Refabricated 26.3 source.
# Every value is cited; the generator turns these rows into data/corn_delight/<decl_dir>/{block,item,creative_tab}.

[tab]
source = "CDj/CornDelightCreativeGroup.java (title itemGroup.corn_delight, icon CORN, ITEMS in registry order)"
title = "itemGroup.corn_delight"
icon = "corn"

# ------------------------------------------------------------------ blocks (BlockRegistry order)

[blocks.corn_crop]
source = "CDj/block/BlockRegistry.java:CORN_CROP (CornCrop, ofLegacyCopy(WHEAT)); CDj/block/CornCrop.java:UPPER_SHAPE_BY_AGE; MMLib HighCropBlock lower shapes 4/8/12/16 px, UPPER boolean"
# Template minecraft:wheat (CropBlock age 0-7, wheat's properties, farmland survival); `upper` declared. Growth of
# the two halves, upper survival and bone meal are code (CD-06). Block item = corn_seeds (ItemFoodSeeds).
template = "minecraft:wheat"
state_properties = { upper = { type = "boolean" } }
default_state = { age = "0", upper = "false" }
lower_px = [4, 8, 12, 16, 16, 16, 16, 16]
upper_px = [4, 6, 8, 12, 14, 14, 14, 14]
block_item = "seeds"

[blocks.wild_corn]
source = "CDj/block/BlockRegistry.java:WILD_CORN (FD WildCropBlock(SATURATION, 8), ofLegacyCopy(TALL_GRASS)); FD WildCropBlock.SHAPE; CDg data_maps compostables wild_corn 0.55"
# As the base's FD wild crops (template short_dry_grass for the worldgen survival rule, E-25; grass sounds, plant
# map colour); ground, bone meal spread and the stew effect are the base's api::wild_crop (CD-07).
template = "minecraft:short_dry_grass"
properties = { sounds = "minecraft:short_grass", map_color = 7 }
shape = [[2, 0, 2, 14, 13, 14]]
no_collision = true
compost = 0.55

[blocks.corn_crate]
source = "CDj/block/BlockRegistry.java:CORN_CRATE (ofLegacyCopy(OAK_PLANKS).strength(2.0F, 3.0F).sound(WOOD))"
template = "minecraft:oak_planks"
properties = { hardness = 2.0, explosion_resistance = 3.0 }

[blocks.corn_kernel_bag]
source = "CDj/block/BlockRegistry.java:CORN_KERNAL_BAG (ofLegacyCopy(WHITE_WOOL))"
template = "minecraft:white_wool"

[blocks.nachos_block]
source = "CDj/block/BlockRegistry.java:NACHOS_BLOCK (NachosBlock, ofLegacyCopy(CAKE): strength 0.5, sound WOOL, pushReaction DESTROY, mapColor NONE); CDj/block/NachosBlock.java:PLATE_SHAPE,NACHOS_SHAPE"
# A feast as the base's (template stonecutter for `facing`, servings 0-4 placed full); serving is the base's
# api::feast (CD-11). The item stacks to 64 (CD's BlockItem, unlike FD's feasts).
template = "minecraft:stonecutter"
properties = { hardness = 0.5, explosion_resistance = 0.5, requires_tool = false, sounds = "minecraft:white_wool", map_color = 0, push_reaction = "POPPED" }
state_properties = { servings = { type = "enum", values = ["0", "1", "2", "3", "4"] } }
default_state = { facing = "north", servings = "4" }
servings_shapes_px = { "0" = [[1, 0, 1, 15, 2, 15]], "default" = [[1, 0, 1, 15, 2, 15], [2, 2, 2, 14, 5, 14]] }

[blocks.popcorn_box]
source = "CDj/block/PopcornBoxBlock.java (FeastBlock(ofLegacyCopy(YELLOW_WOOL), CARAMEL_POPCORN, true): strength 0.8, sound WOOL, mapColor COLOR_YELLOW); getShape not overridden (BOX_SHAPE unused) → FD 26.3 FeastBlock.SHAPES"
template = "minecraft:stonecutter"
properties = { hardness = 0.8, explosion_resistance = 0.8, requires_tool = false, sounds = "minecraft:yellow_wool", map_color = 18, push_reaction = "PUSH_PULL" }
state_properties = { servings = { type = "enum", values = ["0", "1", "2", "3", "4"] } }
default_state = { facing = "north", servings = "4" }
servings_shapes_px = { "0" = [[2, 0, 2, 14, 2, 14]], "1" = [[2, 0, 2, 14, 2, 14]], "2" = [[2, 0, 2, 14, 4, 14]], "3" = [[2, 0, 2, 14, 6, 14]], "4" = [[2, 0, 2, 14, 8, 14]] }

# ------------------------------------------------------------------ items (ItemRegistry order)
# Foods: MMLib FoodInfo.amountAndCalories(nutrition, saturation modifier) → FoodProperties (saturation =
# nutrition × modifier × 2 in float), eat time 32 ticks (the vanilla default), effects with probability 1 and
# MobEffectInstance defaults (particles and icon shown). `remainder` = craftRemainder + stacksTo(16), handed back on
# eating (ItemFoodBase#finishUsingItem). FD FoodValues durations: BRIEF 600, SHORT 1200, MEDIUM 3600, LONG 6000.

[items.wild_corn]
source = "CDj/item/ItemRegistry.java:WILD_CORN (BlockItem)"
kind = "block"
[items.corn_crate]
source = "CDj/item/ItemRegistry.java:CORN_CRATE (BlockItem)"
kind = "block"
[items.corn_kernel_bag]
source = "CDj/item/ItemRegistry.java:CORN_KERNAL_BAG (BlockItem)"
kind = "block"
[items.nachos_block]
source = "CDj/item/ItemRegistry.java:NACHOS_BLOCK (BlockItem)"
kind = "block"
[items.popcorn_box]
source = "CDj/item/ItemRegistry.java:POPCORN_BOX (BlockItem)"
kind = "block"

[items.corn]
source = "CDj/item/ItemRegistry.java:CORN (2, 0.2); CDj/CornDelight.java addFoodToVillage(CORN, 1); CDg compostables 0.65"
food = [2, 0.2]
villager_food = 1
compost = 0.65

[items.corncob]
source = "CDj/item/ItemRegistry.java:CORNCOB (Item); CDg compostables 0.25, furnace_fuels 100"
compost = 0.25
fuel = 100

[items.corn_seeds]
source = "CDj/item/ItemRegistry.java:CORN_SEEDS (ItemFoodSeeds(CORN_CROP), 1, 0.2); CDg compostables 0.35"
# Places corn_crop on use against a block, eats otherwise (as the base's FD onion).
food = [1, 0.2]
block = "corn_crop"
compost = 0.35

